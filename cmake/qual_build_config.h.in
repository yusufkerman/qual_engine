/**
 * @file qual_build_config.h
 * @brief CMake tarafindan uretilen build yapilandirma bilgileri.
 *
 * BU DOSYA OTOMATIK URETILIR - elle duzenlemeyin.
 * Kaynak: cmake/qual_build_config.h.in
